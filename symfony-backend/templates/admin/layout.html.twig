{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | Frikistore{% endblock %}

{% block body %}
<div class="flex min-h-[calc(100vh-80px)]">
    {# Admin Sidebar #}
    <aside class="w-64 bg-slate-900 border-r border-slate-800 hidden md:block flex-shrink-0">
        <div class="p-6">
            <p class="text-xs font-black text-slate-500 uppercase tracking-widest mb-6">Navegación Admin</p>
            <nav class="space-y-2">
                <a href="{{ path('admin_dashboard') }}" class="flex items-center space-x-3 p-3 rounded-xl transition-all {{ app.request.get('_route') == 'admin_dashboard' ? 'bg-friki-neon text-friki-dark font-bold' : 'text-slate-400 hover:bg-slate-800 hover:text-white' }}">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>
                <a href="{{ path('admin_products') }}" class="flex items-center space-x-3 p-3 rounded-xl transition-all {{ app.request.get('_route') == 'admin_products' ? 'bg-friki-neon text-friki-dark font-bold' : 'text-slate-400 hover:bg-slate-800 hover:text-white' }}">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    <span>Productos</span>
                </a>
                <a href="#" class="flex items-center space-x-3 p-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Pedidos</span>
                </a>
                <a href="#" class="flex items-center space-x-3 p-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                    <i class="fa-solid fa-users-gear"></i>
                    <span>Usuarios</span>
                </a>
            </nav>

            <div class="mt-12">
                <p class="text-xs font-black text-slate-500 uppercase tracking-widest mb-6">Configuración</p>
                <nav class="space-y-2">
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                        <i class="fa-solid fa-gears"></i>
                        <span>Ajustes</span>
                    </a>
                    <a href="{{ path('app_home') }}" class="flex items-center space-x-3 p-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                        <i class="fa-solid fa-eye"></i>
                        <span>Ver Tienda</span>
                    </a>
                </nav>
            </div>
        </div>
    </aside>

    {# Main Admin Content #}
    <main class="flex-grow p-8 bg-friki-dark/50">
        {% block admin_content %}{% endblock %}
    </main>
</div>
{% endblock %}
