<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Frikistore | El universo en tus manos{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🕹️</text></svg>">
        
        {# Fonts #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
        
        {# Tailwind CSS & FontAwesome #}
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            'friki-dark': '#0f172a',
                            'friki-card': '#1e293b',
                            'friki-neon': '#22c55e', // Verde Neón
                            'friki-accent': '#a855f7', // Morado
                        },
                        fontFamily: {
                            'orbitron': ['Orbitron', 'sans-serif'],
                            'inter': ['Inter', 'sans-serif'],
                        }
                    }
                }
            }
        </script>

        <style>
            :root {
                --neon-green: #22c55e;
                --neon-purple: #a855f7;
            }
            body { 
                font-family: 'Inter', sans-serif; 
                background-color: #0f172a; 
                color: #f8fafc;
                background-image: 
                    radial-gradient(circle at 50% 50%, rgba(15, 23, 42, 0) 0%, #0f172a 100%),
                    linear-gradient(rgba(34, 197, 94, 0.03) 1px, transparent 1px),
                    linear-gradient(90px, rgba(34, 197, 94, 0.03) 1px, transparent 1px);
                background-size: 100% 100%, 40px 40px, 40px 40px;
            }
            h1, h2, h3, .font-orbitron { font-family: 'Orbitron', sans-serif; }
            
            /* Custom Scrollbar */
            ::-webkit-scrollbar { width: 8px; }
            ::-webkit-scrollbar-track { background: #0f172a; }
            ::-webkit-scrollbar-thumb { 
                background: #1e293b; 
                border-radius: 10px; 
                border: 2px solid #0f172a;
            }
            ::-webkit-scrollbar-thumb:hover { background: var(--neon-green); }

            /* Neon Utilities */
            .neon-border { border: 1px solid var(--neon-green); box-shadow: 0 0 10px rgba(34, 197, 94, 0.2); }
            .neon-text { text-shadow: 0 0 10px rgba(34, 197, 94, 0.5); }
            .neon-btn { transition: all 0.3s ease; }
            .neon-btn:hover { box-shadow: 0 0 20px rgba(34, 197, 94, 0.4); }
            
            .glass { background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(12px); }
            
            /* Scanline animation */
            .scanline {
                width: 100%; height: 2px;
                background: rgba(34, 197, 94, 0.1);
                position: fixed; top: 0; left: 0;
                z-index: 9999; pointer-events: none;
                animation: scanline 8s linear infinite;
            }
            @keyframes scanline {
                0% { transform: translateY(-100vh); }
                100% { transform: translateY(100vh); }
            }
        </style>

        {% block stylesheets %}{% endblock %}
    </head>
    <body class="min-h-screen flex flex-col">
        <div class="scanline"></div>
        {# Navbar #}
        <nav class="sticky top-0 z-50 glass border-b border-slate-700">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-20 items-center">
                    {# Logo #}
                    <div class="flex-shrink-0 flex items-center">
                        <a href="{{ path('app_home') }}" class="text-2xl font-black font-orbitron text-friki-neon tracking-wider">
                            FRIKI<span class="text-white">STORE</span>
                        </a>
                    </div>

                    {# Desktop Menu #}
                    <div class="hidden md:flex space-x-8 items-center">
                        <a href="{{ path('app_home') }}" class="hover:text-friki-neon transition-colors">Inicio</a>
                        <a href="{{ path('product_index') }}" class="hover:text-friki-neon transition-colors">Catálogo</a>
                        <div class="relative group">
                            <button class="flex items-center hover:text-friki-neon transition-colors">
                                Categorías <i class="fa-solid fa-chevron-down ml-2 text-xs"></i>
                            </button>
                            <div class="absolute left-0 mt-2 w-48 rounded-md shadow-lg py-1 bg-friki-card ring-1 ring-black ring-opacity-5 hidden group-hover:block border border-slate-700">
                                <a href="{{ path('product_index', {'categoria': 'Videojuegos'}) }}" class="block px-4 py-2 text-sm hover:bg-slate-700 hover:text-friki-neon">Videojuegos</a>
                                <a href="{{ path('product_index', {'categoria': 'Anime'}) }}" class="block px-4 py-2 text-sm hover:bg-slate-700 hover:text-friki-neon">Anime & Manga</a>
                                <a href="{{ path('product_index', {'categoria': 'Comics'}) }}" class="block px-4 py-2 text-sm hover:bg-slate-700 hover:text-friki-neon">Cómics</a>
                                <a href="{{ path('product_index', {'categoria': 'Juegos de mesa'}) }}" class="block px-4 py-2 text-sm hover:bg-slate-700 hover:text-friki-neon">Juegos de Mesa</a>
                            </div>
                        </div>
                    </div>

                    {# Search & Cart #}
                    <div class="flex items-center space-x-6">
                        <form action="{{ path('product_index') }}" method="GET" class="hidden lg:flex items-center bg-slate-800 rounded-full px-4 py-1.5 border border-slate-700 focus-within:border-friki-neon transition-all">
                            <input type="text" name="buscar" placeholder="Buscar tesoros..." class="bg-transparent border-none focus:ring-0 text-sm w-48 text-white placeholder-slate-400">
                            <button type="submit"><i class="fa-solid fa-magnifying-glass text-slate-400 hover:text-friki-neon"></i></button>
                        </form>

                        <div class="flex items-center space-x-4">
                            {% if app.user %}
                                <a href="{{ path('app_user_profile') }}" class="hover:text-friki-neon transition-colors">
                                    <i class="fa-solid fa-user text-xl"></i>
                                </a>
                                <a href="{{ path('app_logout') }}" class="text-sm text-slate-400 hover:text-red-400">Salir</a>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="text-sm font-semibold hover:text-friki-neon transition-colors">Login</a>
                                <a href="{{ path('app_register') }}" class="bg-friki-neon text-friki-dark px-4 py-2 rounded-lg text-sm font-bold hover:bg-white transition-all transform hover:scale-105">Registro</a>
                            {% endif %}
                            
                            <a href="{{ path('cart_index') }}" class="relative p-2 text-white hover:text-friki-neon transition-colors">
                                <i class="fa-solid fa-cart-shopping text-xl"></i>
                                <span class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-friki-dark transform translate-x-1/2 -translate-y-1/2 bg-friki-neon rounded-full">
                                    {{ app.session.get('cart')|length|default(0) }}
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        {# Flash Messages #}
        <div class="max-w-7xl mx-auto px-4 mt-4 w-full">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="p-4 mb-4 text-sm rounded-lg {% if label == 'success' %}bg-green-900 text-green-200 border border-green-500{% else %}bg-red-900 text-red-200 border border-red-500{% endif %}" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# Main Content #}
        <main class="flex-grow">
            {% block body %}{% endblock %}
        </main>

        {# Footer #}
        <footer class="bg-slate-900 border-t border-slate-800 pt-12 pb-8">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                    <div class="col-span-1 md:col-span-2">
                        <a href="#" class="text-2xl font-black font-orbitron text-friki-neon tracking-wider">FRIKISTORE</a>
                        <p class="mt-4 text-slate-400 max-w-sm">
                            Tu cuartel general para todo lo relacionado con la cultura geek. Desde figuras de colección hasta los últimos lanzamientos en videojuegos.
                        </p>
                        <div class="flex space-x-4 mt-6">
                            <a href="#" class="text-slate-400 hover:text-friki-neon text-xl"><i class="fa-brands fa-discord"></i></a>
                            <a href="#" class="text-slate-400 hover:text-friki-neon text-xl"><i class="fa-brands fa-twitch"></i></a>
                            <a href="#" class="text-slate-400 hover:text-friki-neon text-xl"><i class="fa-brands fa-instagram"></i></a>
                            <a href="#" class="text-slate-400 hover:text-friki-neon text-xl"><i class="fa-brands fa-x-twitter"></i></a>
                        </div>
                    </div>
                    <div>
                        <h3 class="font-orbitron text-white text-lg mb-4">Explorar</h3>
                        <ul class="space-y-2 text-slate-400">
                            <li><a href="{{ path('product_index') }}" class="hover:text-friki-neon">Novedades</a></li>
                            <li><a href="#" class="hover:text-friki-neon">Ofertas Flash</a></li>
                            <li><a href="#" class="hover:text-friki-neon">Más Vendidos</a></li>
                            <li><a href="#" class="hover:text-friki-neon">Próximamente</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="font-orbitron text-white text-lg mb-4">Soporte</h3>
                        <ul class="space-y-2 text-slate-400">
                            <li><a href="#" class="hover:text-friki-neon">Envíos Galácticos</a></li>
                            <li><a href="#" class="hover:text-friki-neon">Devoluciones</a></li>
                            <li><a href="#" class="hover:text-friki-neon">Preguntas Frecuentes</a></li>
                            <li><a href="#" class="hover:text-friki-neon">Contacto</a></li>
                        </ul>
                    </div>
                </div>
                <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center text-slate-500 text-sm">
                    <p>&copy; {{ "now"|date("Y") }} Frikistore API. Todos los derechos reservados.</p>
                    <div class="flex space-x-6 mt-4 md:mt-0">
                        <a href="#" class="hover:text-white">Privacidad</a>
                        <a href="#" class="hover:text-white">Términos</a>
                        <a href="#" class="hover:text-white">Cookies</a>
                    </div>
                </div>
            </div>
        </footer>

        {% block javascripts %}
            <script>
                // Basic scroll effect for navbar
                window.addEventListener('scroll', () => {
                    const nav = document.querySelector('nav');
                    if (window.scrollY > 10) {
                        nav.classList.add('shadow-xl', 'bg-friki-dark/90');
                    } else {
                        nav.classList.remove('shadow-xl', 'bg-friki-dark/90');
                    }
                });
            </script>
        {% endblock %}
    </body>
</html>
